# EcoTrack Environment Variables Template
# Copy this file to Backend/.env and fill in the values.

# Database Credentials
# Update DB_USERNAME and DB_PASSWORD if you chose something other than 'postgres' during pgAdmin 4 installation.
DB_URL=jdbc:postgresql://localhost:5432/ecotrack
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT Authentication
# Keep this secret safe in production!
JWT_SECRET=EcoTrackSuperSecretKeyForJWTAuthentication2026!

# AI Integration
# Optional: Add your OpenAI API Key to enable the AI Sustainability Assistant feature.
OPENAI_API_KEY=
